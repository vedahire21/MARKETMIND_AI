# Environment Variables Specification - MarketMind AI

# App Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketmind?schema=public

# Redis Cache & Lock
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=super-secret-jwt-key-marketmind-production-grade
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-marketmind-production-grade

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# AWS Credentials & Bedrock Config
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_SQS_ORDER_QUEUE_URL=http://localhost:4566/000000000000/marketmind-order-queue
AWS_BEDROCK_KNOWLEDGE_BASE_ID=mock_kb_id
AWS_BEDROCK_GUARDRAIL_ID=mock_guardrail_id

# CloudWatch / Telemetry
LOG_LEVEL=info
